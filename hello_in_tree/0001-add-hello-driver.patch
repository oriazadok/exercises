diff -ruN --no-dereference a/drivers/misc/hello/hello.c b/drivers/misc/hello/hello.c
--- a/drivers/misc/hello/hello.c	1970-01-01 02:00:00.000000000 +0200
+++ b/drivers/misc/hello/hello.c	2026-11-20 16:28:49.435720875 +0200
@@ -0,0 +1,17 @@
+#include <linux/module.h>
+
+static int __init hello_init(void) {
+	printk(KERN_INFO "Hello world!\n");
+
+	return 0;
+}
+
+static void __exit hello_exit(void) {
+	printk(KERN_INFO "Bye bye world!\n");
+}
+
+
+MODULE_LICENSE("GPL");
+
+module_init(hello_init);
+module_exit(hello_exit);
diff -ruN --no-dereference a/drivers/misc/hello/Kconfig b/drivers/misc/hello/Kconfig
--- a/drivers/misc/hello/Kconfig	1970-01-01 02:00:00.000000000 +0200
+++ b/drivers/misc/hello/Kconfig	2026-11-20 16:28:49.435720875 +0200
@@ -0,0 +1,4 @@
+config HELLO
+	tristate "Hello world module"
+	help
+	  prints hello world on load and bye bye world on unload
diff -ruN --no-dereference a/drivers/misc/hello/Makefile b/drivers/misc/hello/Makefile
--- a/drivers/misc/hello/Makefile	1970-01-01 02:00:00.000000000 +0200
+++ b/drivers/misc/hello/Makefile	2026-11-20 16:28:49.435720875 +0200
@@ -0,0 +1 @@
+obj-m += hello.o
